# Database (Neon / PostgreSQL). Optional for the core generator,
# required for short share links and global trending statistics.
DATABASE_URL=

# Upstash Redis — used for rate limiting on API routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL, used to build share links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret used to obfuscate share IDs in some derivation contexts.
SHARE_HASH_SALT=

# Optional: protect /api/trending?admin=1 breakdowns.
ADMIN_STATS_TOKEN=
